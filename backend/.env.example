# Application Server Port
PORT=8080

# Supabase PostgreSQL Configuration
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=postgres.your_supabase_project_ref
DB_PASSWORD=your_supabase_database_password

# JWT Security Configuration
JWT_SECRET=9a4f2c8d7e1b5a3f6c8e0d2b4a6f8c1e3d5b7a9f2c4e6d8b0a3f5c7e9d1b3f5a
JWT_EXPIRATION_MS=86400000

# Spring Environment Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Set to true to use embedded H2 database during offline testing
USE_IN_MEMORY_DB=false
